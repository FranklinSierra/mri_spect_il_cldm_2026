# Copy to .env and adjust for your machine ( .env is gitignored ).
# Source before running:  set -a && source .env && set +a

# Optional: host path bind-mounted to IL-CLDM/data in Docker (see start_devcontainer.sh)
# HOST_DATA_DIR=/path/to/your/data

# Legacy fsierra symlink workflow only (prepare_fsierra_data.py)
# ILCLDM_SOURCE_ROOT=/path/to/fsierra/volumes_norm

# GPU selection (also supported via scripts/run_ablation.py --gpu N)
CUDA_DEVICE_ORDER=PCI_BUS_ID
CUDA_VISIBLE_DEVICES=0

# Stage-2 checkpoints (defaults work if you follow RUNBOOK.md)
# ILCLDM_AAE_CHECKPOINT=result/exp_nm_s1_spect/AAE.pth.tar
# ILCLDM_MRI_ENCODER_CHECKPOINT=result/exp_nm_s1_mri/phase1_mri/checkpoints/MRI_AAE.pth.tar
